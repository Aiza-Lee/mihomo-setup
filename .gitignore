# ==============================================================================
# Mihomo Git 忽略规则
# 保护私人订阅、节点密钥与本地运行时数据
# ==============================================================================

# 运行时主配置与历史备份（核心敏感数据）
config/config.yaml
config/config.yaml.bak*

# 运行时缓存数据库与节点缓存
config/cache.db
config/providers/*
!config/providers/.gitkeep

# 临时文件与日志
*.log
*.tmp
/tmp/
.DS_Store

# 本机装配解压后的单一核心二进制 (统一由 bin/arch/ 下的多架构版本库纳管)
bin/mihomo
